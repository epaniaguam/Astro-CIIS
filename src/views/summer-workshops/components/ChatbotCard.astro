---
interface Props {
  title?: string;
  description?: string;
  url: string;
}

const { title = 'Asistente Virtual', description = 'Habla con nuestro asistente experto para resolver dudas sobre los cursos y el proceso de inscripción.', url } : Props = Astro.props;
---

<div class="w-full max-w-4xl mx-auto px-6">
  <div class="bg-[rgba(8,12,30,0.6)] rounded-2xl p-6 flex flex-col md:flex-row items-center gap-6 shadow-lg">
    <div class="flex-1">
      <h4 class="text-xl font-extrabold text-yellow-200">{title}</h4>
      <p class="text-sm text-slate-100/85 mt-2">{description}</p>
    </div>

    <div class="flex-shrink-0">
      <a
        href={url}
        target="_blank"
        rel="noopener noreferrer"
        class="inline-block px-5 py-3 bg-blue-700 hover:bg-blue-800 text-white rounded-full font-semibold shadow-md transition-colors duration-200"
      >
        Abrir Chatbot
      </a>
    </div>
  </div>
</div>
